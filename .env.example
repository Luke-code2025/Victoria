# Copy this file to .env and enter your SMTP provider details.
PORT=3000
ALLOWED_ORIGIN=http://localhost:3000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# MAIL_FROM should usually be an address authorized by your SMTP provider.
MAIL_FROM=hello@example.com
MAIL_TO=you@example.com
