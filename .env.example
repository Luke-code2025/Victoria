# Example .env file for the Node email server
# Copy to .env and fill values before running `npm install` and `npm start`

# SMTP configuration (use your provider credentials)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Optional override sender and recipient
FROM_EMAIL=you@yourdomain.com
TO_EMAIL=alalopoko@gmail.com

# Server port
PORT=3000
